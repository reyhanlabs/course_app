# Salin file ini menjadi .env.local lalu isi dari Firebase Console
# (Project settings > General > Your apps > Web app > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nama lembaga yang tampil di sidebar dan halaman login
VITE_APP_NAME=English Course

# Isi true untuk memakai Firebase Emulator Suite saat development lokal
VITE_USE_EMULATORS=false
